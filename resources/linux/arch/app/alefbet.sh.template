#!/bin/bash

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-~/.config}

# Allow users to override command-line options
if [[ -f $XDG_CONFIG_HOME/alefbet@@CHANNEL_SUFFIX@@-flags.conf ]]; then
    ALEFBET_USER_FLAGS="$(grep -v '^#' $XDG_CONFIG_HOME/alefbet@@CHANNEL_SUFFIX@@-flags.conf)"
fi

# Launch
exec /opt/alefbet/alefbet@@CHANNEL_SUFFIX@@/@@BINARY_NAME@@ $ALEFBET_USER_FLAGS "$@"
